# ============================================================================
# TeacherTemplate VTR Evidence Hub — Environment Variables
# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.
# NEVER commit real values. None of these (except NEXT_PUBLIC_APP_URL) are sent to the browser.
# ============================================================================

# --- Supabase (server-only; service role bypasses RLS — never expose to the client) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Drive owner connects once via Settings → Google Drive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional fallback. Recommended: leave empty and connect from the admin UI;
# the refresh token is then stored AES-256-GCM encrypted in system_settings.
GOOGLE_REFRESH_TOKEN=
# Optional. Leave empty to let the system create "VTR_นิเทศเปิดภาคเรียน_2_2569" in My Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# "file" (default, least privilege: drive.file) or "drive" (only if you use a root folder created outside the app)
GOOGLE_DRIVE_SCOPE=file

# --- Admin & sessions ---
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# Optional separate key for encrypting the Google refresh token (defaults to SESSION_SECRET).
# If you change it (or SESSION_SECRET), reconnect Google Drive.
TOKEN_ENCRYPTION_KEY=
# Optional read-only gallery access code hash (can also be set in Settings → Security)
VIEWER_ACCESS_CODE_HASH=

# --- Public URL (must exactly match the OAuth redirect: <URL>/api/admin/drive/callback) ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Cloudflare Turnstile (CAPTCHA on the public submission form) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- TEST ONLY — never set in production. Enables in-memory DB + fake Drive for the E2E suite.
# VTR_TEST_BACKENDS=1
